<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Glimmer Basic UI"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- スマートフォン側ランチャー: LAUNCHER カテゴリで起動ポイント -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            グラス用アクティビティ: ProjectedContext経由で起動、LAUNCHERカテゴリなし
            [FB対応] android:launchMode="singleTop" を追加。
            既存インスタンスがタスクの先頭にある場合、新しいインスタンスを作らず
            onNewIntent で再利用する。これにより別画面から戻った際の
            UI再表示問題を解決する。
        -->
        <activity
            android:name=".GlassesMainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:requiredDisplayCategory="xr_projected"
            android:label="Glimmer Basic UI - Glasses">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

    </application>
</manifest>
